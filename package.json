{
  "name": "haneda-taxi-guide",
  "private": true,
  "version": "1.0.0",
  "type": "module",
  "scripts": {
    "fetch:osm": "node scripts/fetch-osm.ts",
    "build:data": "node scripts/build-data.ts",
    "dev": "vite",
    "build": "tsc --noEmit && vite build",
    "preview": "vite preview",
    "test": "node scripts/test-routes.ts",
    "predev": "node -e \"require('fs').existsSync('src/data/rjtt.json')||process.exit(1)\" || npm run build:data",
    "prebuild": "node -e \"require('fs').existsSync('src/data/rjtt.json')||process.exit(1)\" || npm run build:data"
  },
  "devDependencies": {
    "@types/node": "^22.10.0",
    "typescript": "~5.7.2",
    "vite": "^6.0.7"
  }
}
